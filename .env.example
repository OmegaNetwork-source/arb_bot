# ============================================================
# SOLANA ARBITRAGE BOT — ENVIRONMENT (SOL-based trading)
# Copy to .env and fill in. Only PRIVATE_KEY and RPC_PRIMARY are required.
# ============================================================

# ---- REQUIRED -----------------------------------------------
# Wallet private key (base58 or JSON array from Phantom/Solflare)
PRIVATE_KEY=your_base58_private_key_here

# RPC URL (e.g. Helius). Example:
# RPC_PRIMARY=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_PRIMARY=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# ---- OPTIONAL: Fallback RPCs (comma-separated) ---------------
# RPC_FALLBACKS=https://api.mainnet-beta.solana.com

# ---- Jito (defaults work without extra keys) -----------------
# JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# JITO_TIP_LAMPORTS=1000000

# ---- TRADING (SOL) -------------------------------------------
# SOL per trade
TRADE_AMOUNT_SOL=0.1
# Min net profit in SOL to execute
MIN_PROFIT_SOL=0.001
# Slippage in basis points (50 = 0.5%)
MAX_SLIPPAGE_BPS=50
# Priority fee (microlamports per compute unit)
PRIORITY_FEE_MICRO_LAMPORTS=100000
# Max SOL to spend on fees per trade (safety)
MAX_SOL_PER_TRADE_FEES=0.01

# ---- SCANNING -------------------------------------------------
# SCANNER_REFRESH_INTERVAL_MS=30000
# PRICE_CHECK_INTERVAL_MS=2000
# MIN_TOKEN_VOLUME_24H=50000
# MIN_PRICE_CHANGE_PCT=1.0
# MAX_CONCURRENT_CHECKS=10

# ---- RISK -----------------------------------------------------
# Circuit breaker: pause after N consecutive failures
MAX_CONSECUTIVE_FAILURES=5
# Stop bot if daily loss exceeds this (SOL)
DAILY_LOSS_LIMIT_SOL=0.5
# Cooldown per token between trades (ms)
TOKEN_COOLDOWN_MS=5000

# ---- APIs (optional) ------------------------------------------
# Jupiter API — get a free key at https://portal.jup.ag (required for higher rate limits)
# The new unified API endpoint (replaces deprecated quote-api.jup.ag/v6)
# JUPITER_API_URL=https://api.jup.ag/swap/v1
# JUPITER_API_KEY=
# BIRDEYE_API_KEY=

# ---- LOGGING --------------------------------------------------
# LOG_LEVEL=info
# LOG_TO_FILE=true
# LOG_DIR=./logs

# ---- DASHBOARD -------------------------------------------------
# Port for monitoring UI (default 3344)
# DASHBOARD_PORT=3344
